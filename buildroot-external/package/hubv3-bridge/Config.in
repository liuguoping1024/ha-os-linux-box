config BR2_PACKAGE_HUBV3_BRIDGE
	bool "hubv3-bridge"
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LIBWEBSOCKETS
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_CJSON
	select BR2_PACKAGE_MOSQUITTO
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_JQ
	help
	  LinuxBox HubV3 Bridge - IoT Device Integration Service.
	  A C-based bridge daemon that connects Zigbee2MQTT, Home Assistant,
	  and ThirdReality cloud via MQTT/WebSocket, providing device state
	  synchronization, remote command execution, and OTA update support.

	  https://github.com/liuguoping1024/hubv3_service

comment "hubv3-bridge needs a toolchain w/ dynamic library"
	depends on BR2_STATIC_LIBS
