[Unit]
Description=hubv3-supervisor persistent state
Requires=mnt-overlay.mount hubv3-overlay.service
After=mnt-overlay.mount hubv3-overlay.service
Before=supervisor.service

[Mount]
What=/mnt/overlay/var/lib/hubv3-supervisor
Where=/var/lib/hubv3-supervisor
Type=none
Options=bind

[Install]
WantedBy=os-bind.target
