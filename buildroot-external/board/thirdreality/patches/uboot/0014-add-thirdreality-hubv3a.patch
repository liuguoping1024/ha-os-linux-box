 board/amlogic/hub-v3a/Makefile                |   3 +
 board/amlogic/hub-v3a/hub-v3a.c               | 205 +++++++++++++
 configs/hub_v3a_defconfig                     |  83 +++++
 5 files changed, 631 insertions(+)
